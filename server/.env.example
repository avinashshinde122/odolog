# Copy this file to .env and fill in real values.
# See README.md "Google Cloud setup" for how to obtain the client id/secret.

# OAuth client from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on that OAuth client
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Where the React app runs — the backend redirects here after login,
# and only this origin is allowed to call the API with credentials
FRONTEND_URL=http://localhost:5173

# Random 32-byte hex string used to encrypt the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=4000
